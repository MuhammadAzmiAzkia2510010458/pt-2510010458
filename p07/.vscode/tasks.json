{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ (baseline kelas)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-g",
        "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    }
  ]
}
